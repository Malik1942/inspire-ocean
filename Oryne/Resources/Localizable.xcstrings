    "Ask questions across your captured fragments. Oryne helps find patterns, connections, and unfinished ideas worth returning to.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "向你捕捉的碎片提问。Oryne 帮你发现其中的脉络、联系，以及值得回头的未竟灵感。"
          }
        }
      }
    },
